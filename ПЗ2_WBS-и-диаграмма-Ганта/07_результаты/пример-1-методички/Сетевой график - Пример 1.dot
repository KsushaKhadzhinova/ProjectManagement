digraph NET {
  graph [rankdir=LR, nodesep=0.35, ranksep=0.55];
  node [shape=plain, fontname="Arial", fontsize=10];
  edge [color="#555555"];
  n1 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>1</td><td bgcolor="#f4b183"><b>1</b></td><td>4</td></tr><tr><td colspan="3">Устав и стартовое<br/>совещание</td></tr><tr><td>1</td><td>D=3, R=0</td><td>4</td></tr></table>>];
  n2 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>4</td><td bgcolor="#f4b183"><b>2</b></td><td>9</td></tr><tr><td colspan="3">Анализ регламентов<br/>ИБ</td></tr><tr><td>4</td><td>D=5, R=0</td><td>9</td></tr></table>>];
  n1 -> n2 [color="#c00000", penwidth=2.2];
  n3 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>9</td><td bgcolor="#f4b183"><b>3</b></td><td>13</td></tr><tr><td colspan="3">Фишинг-замер + отчёт</td></tr><tr><td>9</td><td>D=4, R=0</td><td>13</td></tr></table>>];
  n2 -> n3 [color="#c00000", penwidth=2.2];
  n4 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#2f5597" bgcolor="white"><tr><td>4</td><td bgcolor="#bdd7ee"><b>4</b></td><td>10</td></tr><tr><td colspan="3">Выбор вендора +<br/>договор</td></tr><tr><td>7</td><td>D=6, R=3</td><td>13</td></tr></table>>];
  n1 -> n4 [];
  n5 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#2f5597" bgcolor="white"><tr><td>10</td><td bgcolor="#bdd7ee"><b>5</b></td><td>13</td></tr><tr><td colspan="3">Учётные записи (200<br/>чел.)</td></tr><tr><td>54</td><td>D=3, R=44</td><td>57</td></tr></table>>];
  n4 -> n5 [];
  n6 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>13</td><td bgcolor="#f4b183"><b>6</b></td><td>16</td></tr><tr><td colspan="3">Настройка white-list</td></tr><tr><td>13</td><td>D=3, R=0</td><td>16</td></tr></table>>];
  n3 -> n6 [color="#c00000", penwidth=2.2];
  n4 -> n6 [];
  n7 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#2f5597" bgcolor="white"><tr><td>16</td><td bgcolor="#bdd7ee"><b>7</b></td><td>24</td></tr><tr><td colspan="3">Курс по ПДн (№ 99-З)</td></tr><tr><td>18</td><td>D=8, R=2</td><td>26</td></tr></table>>];
  n6 -> n7 [];
  n8 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>16</td><td bgcolor="#f4b183"><b>8</b></td><td>26</td></tr><tr><td colspan="3">Модули, видео, тесты</td></tr><tr><td>16</td><td>D=10, R=0</td><td>26</td></tr></table>>];
  n6 -> n8 [color="#c00000", penwidth=2.2];
  n9 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>26</td><td bgcolor="#f4b183"><b>9</b></td><td>28</td></tr><tr><td colspan="3">Информирование<br/>сотрудников</td></tr><tr><td>26</td><td>D=2, R=0</td><td>28</td></tr></table>>];
  n7 -> n9 [];
  n8 -> n9 [color="#c00000", penwidth=2.2];
  n10 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>28</td><td bgcolor="#f4b183"><b>10</b></td><td>48</td></tr><tr><td colspan="3">Микрообучение (4<br/>недели)</td></tr><tr><td>28</td><td>D=20, R=0</td><td>48</td></tr></table>>];
  n9 -> n10 [color="#c00000", penwidth=2.2];
  n11 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>48</td><td bgcolor="#f4b183"><b>11</b></td><td>52</td></tr><tr><td colspan="3">Итоговый фишинг +<br/>тест</td></tr><tr><td>48</td><td>D=4, R=0</td><td>52</td></tr></table>>];
  n10 -> n11 [color="#c00000", penwidth=2.2];
  n12 [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="3" color="#c00000" bgcolor="white"><tr><td>52</td><td bgcolor="#f4b183"><b>12</b></td><td>57</td></tr><tr><td colspan="3">Анализ KPI + отчёт<br/>+ регламент</td></tr><tr><td>52</td><td>D=5, R=0</td><td>57</td></tr></table>>];
  n11 -> n12 [color="#c00000", penwidth=2.2];
}